option(
    'snoop-device',
    description: 'Linux module name of the snoop device.',
    type: 'string',
)
option(
    'post-code-bytes',
    description: 'Post code byte size.',
    type: 'integer',
    value: 1,
)
option(
    'host-instances',
    description: 'obmc instances of the host',
    type: 'string',
)
option(
    'snoop',
    type: 'feature',
    description: 'Compile time flag to enable Ipmi snoop.',
    value: 'disabled',
)
option(
    'systemd-target',
    description: 'Target for starting this service.',
    type: 'string',
    value: 'multi-user.target',
)
option('7seg', type: 'feature', description: 'Enable building 7seg POST daemon.')
option('tests', type: 'feature', description: 'Build tests.')
option(
    'rate-limit',
    description: 'Maximum number of POST codes to read from snoop device every'
    + 'second. Value of 0 disables rate limiting.',
    type: 'integer',
    min: 0,
    value: 1000,
)
option(
    'sbmr-boot-progress',
    type: 'feature',
    description: 'Read boot progress code through SSIF.',
    value: 'disabled',
)
option(
    'systemd-after-service',
    description: 'Service after which lpc will start',
    type: 'string',
)
option(
    'pcc',
    type: 'feature',
    description: 'Read post code through PCC.',
    value: 'enabled',
)
option(
    'queued-boot-progress',
    type: 'feature',
    value: 'disabled',
    description: 'Feature to read boot progress in a polling manner',
)
option(
    'poll-interval',
    type: 'integer',
    min: 1,
    value: 100,
    description: 'Polling interval for reading boot progress from devices',
)
option(
    'transport-interface',
    type: 'combo',
    choices: ['i2c', 'usb'],
    value: 'i2c',
    description: 'Transport interface to get Boot Progress (valid: i2c, usb).',
)
option(
    'device-bus',
    type: 'array',
    value: [],
    description: 'Path to the device bus (default: /dev/i2c-0)',
)
option(
    'device-address',
    type: 'array',
    value: [],
    description: 'Address where the device is located',
)
option(
    'cak-cpu-count',
    type: 'combo',
    choices: ['0', '1', '2'],
    value: '0',
    description: 'Number of CPUs emitting CAK post codes',
)
option(
    'cak-boot-progress',
    type: 'feature',
    value: 'disabled',
    description: 'Enable CAK boot-progress monitoring. CPU count is detected at runtime via Entity Manager inventory.',
)
option(
    'l1reset',
    type: 'feature',
    value: 'disabled',
    description: 'Expose com.nvidia.L1Reset D-Bus interface so bmcweb can trigger an L1 SW main reset of the connected TB500/Vera CPU.',
)
